{
  "name": "nimbusstack-knowledge-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:kb": "tsx scripts/build-kb.ts",
    "predev": "npm run build:kb",
    "dev": "next dev",
    "prebuild": "npm run build:kb",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run build:kb && tsc --noEmit",
    "pretest": "npm run build:kb",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "ask": "tsx scripts/ask.ts",
    "probe": "npm run build:kb && tsx scripts/probe-retrieval.ts",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^4.0.58",
    "@ai-sdk/google": "^4.0.92",
    "@ai-sdk/openai-compatible": "^3.0.66",
    "ai": "^7.0.133",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
