{
  "$comment": "Single source of truth for models. Prices are USD per 1M tokens at each provider's paid list price (sources: provider pricing pages / OpenRouter catalogue, checked 2026-10-07). Free-tier usage is billed $0; the app shows the list-price estimate. Disabled models show in the dropdown but are never called.",
  "defaultModel": "groq-gpt-oss",
  "fallbackOrder": [
    "groq-gpt-oss",
    "gemini-flash-lite",
    "gemini-flash",
    "cloudflare-llama",
    "openrouter-nemotron",
    "cohere-command-a",
    "zai-glm-flash",
    "claude-sonnet",
    "openai-gpt",
    "sambanova-llama"
  ],
  "providers": {
    "google": {
      "label": "Google Gemini",
      "type": "google",
      "apiKeyEnv": "GEMINI_API_KEY"
    },
    "groq": {
      "label": "Groq",
      "type": "openai-compatible",
      "baseURL": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY"
    },
    "cloudflare": {
      "label": "Cloudflare Workers AI",
      "type": "openai-compatible",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN"
    },
    "zai": {
      "label": "Z.ai",
      "type": "openai-compatible",
      "baseURL": "https://api.z.ai/api/paas/v4",
      "apiKeyEnv": "ZAI_API_KEY"
    },
    "openrouter": {
      "label": "OpenRouter",
      "type": "openai-compatible",
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "cohere": {
      "label": "Cohere",
      "type": "openai-compatible",
      "baseURL": "https://api.cohere.ai/compatibility/v1",
      "apiKeyEnv": "COHERE_API_KEY"
    },
    "sambanova": {
      "label": "SambaNova",
      "type": "openai-compatible",
      "baseURL": "https://api.sambanova.ai/v1",
      "apiKeyEnv": "SAMBANOVA_API_KEY"
    },
    "anthropic": {
      "label": "Anthropic Claude",
      "type": "openai-compatible",
      "baseURL": "https://api.anthropic.com/v1",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "openai": {
      "label": "OpenAI",
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    }
  },
  "models": [
    {
      "id": "groq-gpt-oss",
      "provider": "groq",
      "model": "openai/gpt-oss-120b",
      "name": "GPT-OSS 120B (Groq)",
      "description": "OpenAI's open-weight model on Groq. Default: fastest, 1,000 free requests/day.",
      "contextWindow": 131072,
      "maxOutputTokens": 4096,
      "pricing": {
        "inputPerMTok": 0.15,
        "outputPerMTok": 0.6
      },
      "enabled": true,
      "providerOptions": {
        "groq": {
          "reasoningEffort": "medium"
        }
      }
