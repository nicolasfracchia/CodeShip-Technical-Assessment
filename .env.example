# Copy to .env.local and fill in the providers you have keys for.
# Any provider without a key is shown as "unavailable" in the dropdown and skipped by the fallback chain.
# Keys are read on the server only; never prefix them with NEXT_PUBLIC_.

GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (free)
GROQ_API_KEY=              # https://console.groq.com/keys        (free)
CLOUDFLARE_API_TOKEN=      # https://dash.cloudflare.com > AI > Workers AI > Use REST API (free)
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=        # https://openrouter.ai/keys          (free models)
COHERE_API_KEY=            # https://dashboard.cohere.com/api-keys (free trial)
ZAI_API_KEY=               # https://z.ai/manage-apikey/apikey-list (glm-4.5-flash is free)

# Optional / placeholders (models appear in the dropdown, disabled until a key is set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SAMBANOVA_API_KEY=
